[Unit]
Description=spotifyd Spotify Connect receiver (controlled by deskpad)
After=network-online.target pulseaudio.service
Wants=network-online.target

[Service]
# A systemd --user unit: spotifyd needs the user's PulseAudio socket and session D-Bus (MPRIS).
# Enable linger so it starts at boot without a login: sudo loginctl enable-linger "$USER"
ExecStart=/usr/bin/spotifyd --no-daemon --config-path %h/.config/spotifyd/spotifyd.conf
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
